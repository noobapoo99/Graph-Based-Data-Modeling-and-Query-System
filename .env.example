# LLM providers
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# Neo4j Aura (cloud) - get from https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_aura_password_here
NEO4J_DATABASE=neo4j

# Redis - Upstash for production, local for dev
REDIS_URL=redis://localhost:6379
# For Upstash, replace with:
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# CORS - comma-separated list of allowed frontend URLs
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.onrender.com

# Protected ingestion endpoint
INGEST_TOKEN=change_me_before_using_ingest

# Local data directories
DATA_DIR=./data
SAP_DATA_DIR=./sap-o2c-data

# Frontend runtime URL
VITE_API_URL=http://localhost:8000
# For production:
# VITE_API_URL=https://your-backend.onrender.com

# Local Vite proxy target
VITE_PROXY_TARGET=http://localhost:8000
